# ====================================================================
# Supabase — obtenha em https://app.supabase.com → Settings → API
# ====================================================================
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...      # apenas server-side (admin)

# ====================================================================
# football-data.org — registre em https://www.football-data.org/client/register
# ====================================================================
FOOTBALL_DATA_API_KEY=sua_chave_gratuita_aqui

# ====================================================================
# Secret para proteger o endpoint /api/sync-matches em cron
# ====================================================================
CRON_SECRET=troque-este-valor-por-um-random-seguro

# ====================================================================
# (opcional) URL pública da aplicação — usada em meta tags
# ====================================================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
